# Generate local values using node scripts/init-staging.mjs; never use staging signing keys in production.
DATABASE_URL=
DB_PASSWORD=
AUTH_MODE=staging
JWT_ISSUER=http://atlashub-staging.local
JWT_AUDIENCE=atlashub-waas
STAGING_JWT_SECRET=
INBOUND_HMAC_SECRET=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
PORT=4000
BIND_HOST=127.0.0.1
# Supabase deployment uses JWKS, not the staging shared signing key:
# AUTH_MODE=supabase
# JWT_ISSUER=https://aakdyumavlzgyklbrsrw.supabase.co/auth/v1
# JWT_JWKS_URL=https://aakdyumavlzgyklbrsrw.supabase.co/auth/v1/.well-known/jwks.json
# JWT_AUDIENCE=authenticated
