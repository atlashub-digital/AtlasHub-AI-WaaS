      }
    },
    "/v1/me/memberships": {
      "get": {
        "operationId": "get__v1_me_memberships",
        "summary": "Active memberships of the caller (tenant switcher)",
        "description": "Lists only the caller's own active memberships (RLS own_memberships). A verified identity without memberships receives an empty list, not 403.",
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MembershipSummary"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid verified identity"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "get__v1_me",
        "summary": "Caller identity, memberships and active modules per tenant",
        "description": "Each tenant is read inside its own RLS context. No memberships → 200 with an empty list.",
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid verified identity"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        }
      }
    },
    "/v1/entitlements": {
      "get": {
        "operationId": "get__v1_entitlements",
        "summary": "Entitlements and derived modules of one tenant",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "tenant",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Required when the caller has more than one membership"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Entitlements"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid verified identity"
          },
          "503": {
            "description": "Dependency unavailable"
          },
          "403": {
            "description": "No membership in the tenant"
          }
        }
      }
    },
