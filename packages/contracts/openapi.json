{
  "openapi": "3.1.0",
  "info": {
    "title": "AtlasHub AI Workforce staging API",
    "version": "0.3.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4000",
      "description": "Local synthetic staging only"
    }
  ],
  "components": {
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "WebhookHMAC": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Atlas-Signature"
      }
    },
    "schemas": {
      "Inbound": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "channel_binding_id",
          "timestamp",
          "payload"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "channel_binding_id": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "conversation_ref",
              "intent_text"
            ],
            "properties": {
              "conversation_ref": {
                "type": "string"
              },
              "intent_text": {
                "type": "string",
                "maxLength": 2000
              },
              "slot_id": {
                "type": "string"
              }
            }
          }
        }
      },
      "Assessment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "business",
          "need",
          "consent"
        ],
        "properties": {
          "business": {
            "type": "string",
            "maxLength": 120
          },
          "need": {
            "type": "string",
            "maxLength": 1000
          },
          "consent": {
            "const": true
          }
        }
      },
      "Decision": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tenant",
          "decision"
        ],
        "properties": {
          "tenant": {
            "type": "string"
          },
          "decision": {
            "enum": [
              "approved",
              "rejected"
            ]
          }
        }
      },
      "Deployment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tenantId",
          "roleId",
          "packReleaseId",
          "config",
          "limits"
        ],
        "properties": {
          "tenantId": {
            "type": "string"
          },
          "roleId": {
            "type": "string"
          },
          "packReleaseId": {
            "type": "string"
          },
          "config": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "clinic_name",
              "handoff_queue"
            ],
            "properties": {
              "clinic_name": {
                "type": "string"
              },
              "handoff_queue": {
                "type": "string"
              }
            }
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dailyRuns",
              "alertAt"
            ],
            "properties": {
              "dailyRuns": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "alertAt": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              }
            }
          }
        }
      },
      "MembershipSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tenantId",
          "role",
          "name",
          "tenantStatus"
        ],
        "properties": {
          "tenantId": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "tenant_user",
              "tenant_admin",
              "atlas_operator",
              "atlas_engineer",
              "atlas_owner"
            ]
          },
          "name": {
            "type": "string",
            "description": "Tenant display name, read inside that tenant's RLS context; falls back to tenantId"
          },
          "tenantStatus": {
            "type": "string",
            "description": "Tenant.status (active, suspended, …). Non-active tenants are listed so the switcher can show them as unavailable; the Core refuses to execute work for them."
          }
        }
      },
      "ModuleKey": {
        "type": "string",
        "enum": [
          "workforce",
          "ami",
          "community",
          "media"
        ],
        "description": "Product module (entitlement key module.<module>); closed list per packages/contracts/modules.json version."
      },
      "MeMembership": {
        "type": "object",
        "required": [
          "tenantId",
          "role",
          "name",
          "tenantStatus",
          "modules"
        ],
        "properties": {
          "tenantId": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "tenant_user",
              "tenant_admin",
              "atlas_operator",
              "atlas_engineer",
              "atlas_owner"
            ]
          },
          "name": {
            "type": "string"
          },
          "tenantStatus": {
            "type": "string"
          },
          "modules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModuleKey"
            }
          }
        }
      },
      "Me": {
        "type": "object",
        "required": [
          "sub",
          "memberships"
        ],
        "properties": {
          "sub": {
            "type": "string"
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MeMembership"
            }
          }
        }
      },
      "EntitlementItem": {
        "type": "object",
        "required": [
          "key",
          "source",
          "validFrom",
          "status",
          "active"
        ],
        "properties": {
          "key": {
            "type": "string",
            "description": "mission.<templateId> · product.<productId> · module.<module>"
          },
          "source": {
            "type": "string",
            "enum": [
              "order",
              "subscription",
              "trial",
              "grant"
            ]
          },
          "quantity": {
            "type": [
              "integer",
              "null"
            ]
          },
          "validFrom": {
            "type": "string",
            "format": "date-time"
          },
          "validUntil": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "expired",
              "revoked"
            ]
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "Entitlements": {
        "type": "object",
        "required": [
          "tenantId",
          "enforced",
          "modules",
          "items"
        ],
        "properties": {
          "tenantId": {
            "type": "string"
          },
          "enforced": {
            "type": "boolean",
            "description": "ENTITLEMENTS_ENFORCE=1 on this deployment"
          },
          "modules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModuleKey"
            }
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntitlementItem"
            }
          }
        }
      },
      "ModuleGrant": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tenant",
          "module"
        ],
        "properties": {
          "tenant": {
            "type": "string"
          },
          "module": {
            "$ref": "#/components/schemas/ModuleKey"
          },
          "validUntil": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ModuleRevoke": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tenant",
          "module"
        ],
        "properties": {
          "tenant": {
            "type": "string"
          },
          "module": {
            "$ref": "#/components/schemas/ModuleKey"
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "get__health",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid schema or transition"
          },
          "401": {
            "description": "Missing or invalid verified identity"
          },
          "403": {
            "description": "Policy or role denied"
          },
          "404": {
            "description": "Scoped resource absent"
          },
          "429": {
            "description": "Mutation rate limit"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        }
      }
    },
    "/ready": {
      "get": {
        "operationId": "get__ready",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid schema or transition"
          },
          "401": {
            "description": "Missing or invalid verified identity"
          },
          "403": {
            "description": "Policy or role denied"
          },
          "404": {
            "description": "Scoped resource absent"
          },
          "429": {
            "description": "Mutation rate limit"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        }
      }
    },
    "/v1/roles": {
      "get": {
        "operationId": "get__v1_roles",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid schema or transition"
          },
          "401": {
            "description": "Missing or invalid verified identity"
          },
          "403": {
            "description": "Policy or role denied"
          },
          "404": {
            "description": "Scoped resource absent"
